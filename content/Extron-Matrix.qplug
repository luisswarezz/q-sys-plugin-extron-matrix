--[[-------------------------------------------------------------------------
Extron DTP CrossPoint 84 (Telnet 23) - Q-SYS Plugin
Aligned from Solo Works London "Matrix" style, but fixed for:
  - DTP CrossPoint 84 = 8 inputs x 4 outputs
  - Proper SIS tie commands: IN*OUT<suffix> + CR
      suffix: ! = AV(All), % = Video only, $ = Audio only
  - Robust parsing of tie feedback (handles bullets/dots/spaces)
  - Fixes "error when loading" by NOT using an array control for input_signal
    (creates input_signal_1..8 instead)
--------------------------------------------------------------------------]]

PluginInfo = {
    Name = "Extron~DTP CrossPoint 84 (Telnet)",
    Version = "1.0.0",
    Id = "qsysc.extron.dtpcp84.telnet.1.0.0",
    Description = "Control for Extron DTP CrossPoint 84 series via Telnet (TCP/23)",
    ShowDebug = true,
    Author = "Solo Works London (updated)"
}

local Colors = {
    extron_blue = {31, 79, 162},
    White = {255, 255, 255},
    Black = {0, 0, 0},
    Red = {255, 0, 0},
    Green = {0, 255, 0}
}

function GetColor(props) return Colors.extron_blue end

local input_count  = 8
local output_count = 4

-- =========================
-- Properties
-- =========================
function GetProperties()
    return {
        { Name = "IP Address", Type = "string", Value = "10.10.132.75" },
        { Name = "Port", Type = "integer", Value = 23 },
        { Name = "Password", Type = "string", Value = "" },
        {
            Name = "Tie Mode",
            Type = "enum",
            Choices = { "AV (All)", "Video Only", "Audio Only" },
            Value = "AV (All)"
        },
        { Name = "Verbose", Type = "boolean", Value = true },
        { Name = "Poll Seconds", Type = "integer", Value = 20 } -- 0 disables
    }
end

function RectifyProperties(props) return props end

-- =========================
-- Controls
-- =========================
function GetControls(props)
    local ctls = {
        -- System
        { Name = "online", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", Count = 1, UserPin = true },
        { Name = "ip_address", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", Count = 1, UserPin = true },
        { Name = "model", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", Count = 1, UserPin = true },
        { Name = "device_name", ControlType = "Text", PinStyle = "Output", UserPin = true },
        { Name = "front_panel_lock", ControlType = "Text", PinStyle = "Both", UserPin = true },
        { Name = "part_no", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", Count = 1, UserPin = true },
        { Name = "firmware_version", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", Count = 1, UserPin = true }
    }

    -- Input signal presence LEDs as INDIVIDUAL controls (prevents load errors)
    for i = 1, input_count do
        table.insert(ctls, {
            Name = "input_signal_" .. i,
            ControlType = "Indicator",
            IndicatorType = "Led",
            PinStyle = "Output",
            Count = 1,
            UserPin = true
        })
    end

    -- Outputs + Crosspoints
    for o = 1, output_count do
        table.insert(ctls, { Name = "output_" .. o, ControlType = "Text", PinStyle = "Both", UserPin = true })
        table.insert(ctls, { Name = "video_mute_" .. o, ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
        for i = 1, input_count do
            table.insert(ctls, {
                Name = "input_" .. i .. "-output_" .. o,
                ControlType = "Button",
                ButtonType = "Toggle",
                PinStyle = "Both",
                UserPin = true
            })
        end
    end

    return ctls
end

-- =========================
-- Pages / Layout
-- =========================
local pagenames = {"Display"}

function GetPages(props)
    return { { name = pagenames[1] } }
end

function GetControlLayout(props)
    local layout = {}

    local title_size = {224, 32}
    local btn_size = {32, 24}

    local status_groupbox_size = props["Verbose"].Value and {title_size[1], 10 * btn_size[2]} or {title_size[1], 6 * btn_size[2]}
    local matrix_groupbox_position = {0, title_size[2] + status_groupbox_size[2] + (0.5 * btn_size[2])}
    local matrix_groupbox_size = {
        72 + (output_count * btn_size[1]),
        16 + (3 * btn_size[2]) + (input_count * btn_size[2])
    }

    local graphics = {
        { Type="Header", Text="Extron DTP CrossPoint 84", HTextAlign="Center", Color=Colors.extron_blue, FontSize=16,
          Position={0,0}, Size=title_size },

        { Type="GroupBox", Text="Status", HTextAlign="Left", Fill=Colors.White, CornerRadius=8,
          StrokeColor=Colors.extron_blue, Color=Colors.extron_blue, StrokeWidth=1,
          Position={0, title_size[2]}, Size=status_groupbox_size },

        { Type="Text", Text="Online:", Font="Roboto", FontSize=12, FontStyle="Bold", HTextAlign="Right",
          Color=Colors.Black, Position={0, title_size[2] + (0.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]} },

        { Type="Text", Text="IP Address:", Font="Roboto", FontSize=12, FontStyle="Bold", HTextAlign="Right",
          Color=Colors.Black, Position={0, title_size[2] + (1.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]} },

        { Type="Text", Text="Model:", Font="Roboto", FontSize=12, FontStyle="Bold", HTextAlign="Right",
          Color=Colors.Black, Position={0, title_size[2] + (2.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]} },

        { Type="Text", Text="Device Name:", Font="Roboto", FontSize=12, FontStyle="Bold", HTextAlign="Right",
          Color=Colors.Black, Position={0, title_size[2] + (3.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]} },

        { Type="Text", Text="Front Panel Lock:", Font="Roboto", FontSize=11.5, FontStyle="Bold", HTextAlign="Right",
          Color=Colors.Black, Position={0, title_size[2] + (4.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]} },

        { Type="GroupBox", Text="Matrix", HTextAlign="Left", Fill=Colors.White, CornerRadius=8,
          StrokeColor=Colors.extron_blue, Color=Colors.extron_blue, StrokeWidth=1,
          Position=matrix_groupbox_position, Size=matrix_groupbox_size },

        { Type="Text", Text="Signal", FontSize=10,
          Position={matrix_groupbox_position[1], (matrix_groupbox_position[2] + (2.5 * btn_size[2]))}, Size=btn_size }
    }

    for i = 1, input_count do
        table.insert(graphics, {
            Type="Text", Text="In" .. i,
            Position={ (matrix_groupbox_position[1] + btn_size[1]),
                       (matrix_groupbox_position[2] + (2.5 * btn_size[2])) + (i * btn_size[2]) },
            Size=btn_size
        })
    end

    for o = 1, output_count do
        table.insert(graphics, {
            Type="Text", Text="Out\r" .. o,
            Position={ btn_size[1] + (o * btn_size[1]), (matrix_groupbox_position[2] + (1.5 * btn_size[2])) },
            Size=btn_size
        })
    end

    -- System layout
    layout["online"] = {
        PrettyName = "System~Online",
        Style = "Indicator",
        Color = {0, 255, 0},
        Position = {3 * btn_size[1], title_size[2] + (0.5 * btn_size[2])},
        Size = {btn_size[2], btn_size[2]}
    }
    layout["ip_address"] = {
        PrettyName = "System~IP Address",
        Style = "Text",
        Position = {3 * btn_size[1], title_size[2] + (1.5 * btn_size[2])},
        Size = {3 * btn_size[1], btn_size[2]}
    }
    layout["model"] = {
        PrettyName = "System~Model",
        Style = "Text",
        Position = {3 * btn_size[1], title_size[2] + (2.5 * btn_size[2])},
        Size = {3 * btn_size[1], btn_size[2]}
    }
    layout["device_name"] = {
        PrettyName = "System~Device Name",
        Style = "Text",
        Position = {3 * btn_size[1], title_size[2] + (3.5 * btn_size[2])},
        Size = {3 * btn_size[1], btn_size[2]}
    }
    layout["front_panel_lock"] = {
        PrettyName = "System~Front Panel Lock",
        Style = "ComboBox",
        Position = {3 * btn_size[1], title_size[2] + (4.5 * btn_size[2])},
        Size = {3 * btn_size[1], btn_size[2]}
    }

    -- Optional verbose fields (kept simple)
    if props["Verbose"].Value then
        table.insert(graphics, {
            Type="Text", Text="Part Number:", Font="Roboto", FontSize=12, FontStyle="Bold", HTextAlign="Right",
            Color=Colors.Black, Position={0, title_size[2] + (6.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]}
        })
        table.insert(graphics, {
            Type="Text", Text="Firmware:", Font="Roboto", FontSize=12, FontStyle="Bold", HTextAlign="Right",
            Color=Colors.Black, Position={0, title_size[2] + (7.5 * btn_size[2])}, Size={3 * btn_size[1], btn_size[2]}
        })
        layout["part_no"] = {
            PrettyName="System~Part Number",
            Style="Text",
            Position={3 * btn_size[1], title_size[2] + (6.5 * btn_size[2])},
            Size={3 * btn_size[1], btn_size[2]}
        }
        layout["firmware_version"] = {
            PrettyName="System~Firmware Version",
            Style="Text",
            Position={3 * btn_size[1], title_size[2] + (7.5 * btn_size[2])},
            Size={3 * btn_size[1], btn_size[2]}
        }
    end

    -- Signal LEDs layout
    for i = 1, input_count do
        layout["input_signal_" .. i] = {
            PrettyName = string.format("Signal Presence~Input %02i", i),
            Style = "Indicator",
            Color = {0, 255, 0},
            Position = {
                (matrix_groupbox_position[1] + (btn_size[1] - btn_size[2]) / 2),
                matrix_groupbox_position[2] + ((i + 2.5) * btn_size[2])
            },
            Size = {btn_size[2], btn_size[2]}
        }
    end

    -- Crosspoints
    for o = 1, output_count do
        layout["output_" .. o] = {
            PrettyName = "Output " .. o .. "~Select",
            Style = "Indicator",
            Position = {btn_size[1] + (o * btn_size[1]), matrix_groupbox_position[2] + (2.5 * btn_size[2])},
            Size = btn_size
        }
        layout["video_mute_" .. o] = {
            PrettyName = "Video Mute~Video Mute " .. o,
            Style = "Button",
            Legend = "Mute",
            Color = {255, 0, 0},
            Position = {btn_size[1] + (o * btn_size[1]), matrix_groupbox_position[2] + (0.5 * btn_size[2])},
            Size = btn_size
        }
        for i = 1, input_count do
            layout["input_" .. i .. "-output_" .. o] = {
                PrettyName = "Output " .. o .. "~In" .. i .. " -> Out" .. o,
                Style = "Button",
                Legend = tostring(i),
                Position = {
                    btn_size[1] + (o * btn_size[1]),
                    matrix_groupbox_position[2] + (2.5 * btn_size[2] + (i * btn_size[2]))
                },
                Size = btn_size
            }
        end
    end

    return layout, graphics
end

-- =========================
-- Runtime
-- =========================
if Controls then
    local Extron = { Host = "", Port = 23, Rx = "" }
    local password = ""

    local conn = TcpSocket.New()
    conn.ReadTimeout = 0
    conn.WriteTimeout = 0
    conn.ReconnectTimeout = 5

    local timerPoll = Timer.New()
    timerPoll.EventHandler = function() end

    local function dbg(msg)
        if PluginInfo.ShowDebug then print(msg) end
    end

    -- Always CR-terminate Extron SIS commands
    local function fnSend(cmd)
        if cmd:sub(-1) ~= "\r" then cmd = cmd .. "\r" end
        dbg("-->Extron::" .. cmd:gsub("\r","\\r"))
        conn:Write(cmd)
    end

    local function tie_suffix()
        local m = Properties["Tie Mode"].Value
        if m == "Video Only" then return "%" end
        if m == "Audio Only" then return "$" end
        return "!" -- AV (All)
    end

    local function matrix_feedback(inp, outp)
        Controls["output_" .. outp].String = tostring(inp)
        for i = 1, input_count do
            Controls["input_" .. i .. "-output_" .. outp].Boolean = false
        end
        local n = tonumber(inp) or 0
        if n > 0 and n <= input_count then
            Controls["input_" .. n .. "-output_" .. outp].Boolean = true
        end
    end

    local function tie_command(inp, outp)
        -- DTP CP84: In*Out<suffix>
        fnSend(tostring(inp) .. "*" .. tostring(outp) .. tie_suffix())
    end

    local function poll_ties()
        -- Query each output's current tie
        for o = 1, output_count do
            fnSend(tostring(o) .. "!")
        end
    end

    local function fnInit()
        -- (Optional) verbose, comment out if you suspect it causes issues:
        if Properties["Verbose"].Value then
            fnSend(string.char(27) .. "3CV")
        end

        -- Basic info
        fnSend("I")
        fnSend("N")
        fnSend("Q")
        fnSend(string.char(27) .. "CN")

        -- Query ties
        poll_ties()
    end

    local function fnConnect()
        conn:Connect(Extron.Host, Extron.Port)
        dbg("TCP socket is Connecting")
        Controls.ip_address.String = Extron.Host .. ":" .. tostring(Extron.Port)
    end

    -- Robust tie feedback parser: works with bullets/spaces:
    -- e.g. "Out03•In01•All" or "Out03 In01 All" etc.
    local function parse_tie_line(line)
        local outp = string.match(line, "Out(%d+)")
        local inp  = string.match(line, "In(%d+)")
        if outp and inp then
            local o = tonumber(outp)
            local i = tonumber(inp)
            if o and i and o >= 1 and o <= output_count then
                matrix_feedback(i, o)
            end
        end
    end

    -- Socket callbacks
    conn.Connected = function()
        Controls.online.Boolean = true
        dbg("TCP socket is Connected")
        Timer.CallAfter(fnInit, 1)

        timerPoll:Stop()
        local sec = tonumber(Properties["Poll Seconds"].Value) or 0
        if sec > 0 then
            timerPoll.EventHandler = poll_ties
            timerPoll:Start(sec)
        end
    end

    conn.Reconnect = function()
        dbg("TCP socket is Reconnecting")
    end

    conn.Closed = function()
        Controls.online.Boolean = false
        dbg("TCP socket closed")
        timerPoll:Stop()
    end

    conn.Error = function(_, err)
        Controls.online.Boolean = false
        dbg("TCP socket error :: " .. tostring(err))
        timerPoll:Stop()
    end

    conn.Timeout = function(_, err)
        Controls.online.Boolean = false
        dbg("TCP socket timeout :: " .. tostring(err))
        timerPoll:Stop()
    end

    conn.Data = function()
        local line = conn:ReadLine(TcpSocket.EOL.Any)
        while line ~= nil do
            dbg("<-- " .. line)

            if line == "Password:" then
                conn:Write(password .. "\r")
            elseif line:sub(1, 3) == "Pno" then
                Controls.part_no.String = line:sub(4, -1)
            elseif line:sub(1, 5) == "Inf01" then
                Controls.model.String = line:sub(7, -1)
            elseif line:sub(1, 5) == "Ver01" then
                Controls.firmware_version.String = line:sub(7, -1)
            elseif line:sub(1, 3) == "Ipn" then
                Controls.device_name.String = line:sub(5, -1)
            elseif line:sub(1, 3) == "Exe" then
                -- Fix: must tonumber(), otherwise load/runtime error
                local lockout_mode = (tonumber(line:sub(4, 4)) or 0) + 1
                if Controls["front_panel_lock"].Choices and Controls["front_panel_lock"].Choices[lockout_mode] then
                    Controls["front_panel_lock"].String = Controls["front_panel_lock"].Choices[lockout_mode]
                end
            elseif string.find(line, "Out%d+") and string.find(line, "In%d+") then
                parse_tie_line(line)
            elseif line == "E10" then
                dbg("Error: Invalid command")
            end

            line = conn:ReadLine(TcpSocket.EOL.Any)
        end
    end

    -- Properties
    if Properties then
        Extron.Host = Properties["IP Address"].Value
        Extron.Port = tonumber(Properties["Port"].Value) or 23
        password = Properties["Password"].Value or ""
    end

    -- Front panel lock combobox
    Controls["front_panel_lock"].Choices = {"Unlocked", "Locked", "Partial"}
    Controls["front_panel_lock"].EventHandler = function()
        for k, v in ipairs(Controls["front_panel_lock"].Choices) do
            if Controls["front_panel_lock"].String == v then
                fnSend(tostring(k - 1) .. "X")
            end
        end
    end

    -- Output direct entry (type input number into output box)
    for o = 1, output_count do
        Controls["output_" .. o].EventHandler = function()
            tie_command(Controls["output_" .. o].String, o)
        end

        -- Video mute (kept from your DXP approach; if your CP84 uses different mute syntax,
        -- this won’t break loading—only mute control.)
        Controls["video_mute_" .. o].EventHandler = function()
            if Controls["video_mute_" .. o].Boolean then
                fnSend(tostring(o) .. "*1B")
            else
                fnSend(tostring(o) .. "*0B")
            end
        end
    end

    -- Crosspoint buttons
    for o = 1, output_count do
        for i = 1, input_count do
            Controls["input_" .. i .. "-output_" .. o].EventHandler = function()
                if Controls["input_" .. i .. "-output_" .. o].Boolean then
                    Controls["output_" .. o].String = tostring(i)
                    tie_command(i, o)
                else
                    Controls["output_" .. o].String = "0"
                    tie_command(0, o) -- untie
                end
            end
        end
    end

    -- Connect on load
    if Extron.Host and Extron.Host ~= "" then
        fnConnect()
    else
        dbg("IP Address Property Not Set")
    end
end
