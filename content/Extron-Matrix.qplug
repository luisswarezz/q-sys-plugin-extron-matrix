-- ============================================================================
-- Extron DTP CrossPoint 84 - Q-SYS Plugin (Telnet 23)
-- 8x4 Matrix
-- Proper SIS: IN*OUT<suffix> + CR
-- ! = AV (All)   % = Video Only   $ = Audio Only
-- ============================================================================

PluginInfo = {
    Name = "Extron~DTP CrossPoint 84 (Telnet)",
    Version = "1.0.0",
    Id = "qsysc.extron.dtpcp84.telnet.1.0.0",
    Description = "Control for Extron DTP CrossPoint 84 via Telnet (TCP/23)",
    ShowDebug = true,
    Author = "Solo Works London (Updated)"
}

local Colors = {
    extron_blue = {31,79,162},
    White = {255,255,255},
    Black = {0,0,0},
    Red = {255,0,0},
    Green = {0,255,0}
}

function GetColor(props) return Colors.extron_blue end

local INPUTS = 8
local OUTPUTS = 4

-- ============================================================================
-- Properties (FIXED: integer properties include Min/Max)
-- ============================================================================
function GetProperties()
    return {
        { Name="IP Address", Type="string", Value="10.10.132.75" },
        { Name="Port", Type="integer", Min=1, Max=65535, Value=23 },
        { Name="Password", Type="string", Value="" },
        {
            Name="Tie Mode",
            Type="enum",
            Choices={"AV (All)","Video Only","Audio Only"},
            Value="AV (All)"
        },
        { Name="Verbose", Type="boolean", Value=true },
        { Name="Poll Seconds", Type="integer", Min=0, Max=3600, Value=20 }
    }
end

function RectifyProperties(props) return props end

-- ============================================================================
-- Controls
-- ============================================================================
function GetControls(props)
    local ctls = {
        { Name="online", ControlType="Indicator", IndicatorType="Led", PinStyle="Output", Count=1, UserPin=true },
        { Name="ip_address", ControlType="Indicator", IndicatorType="Text", PinStyle="Output", Count=1, UserPin=true },
        { Name="model", ControlType="Indicator", IndicatorType="Text", PinStyle="Output", Count=1, UserPin=true },
        { Name="device_name", ControlType="Text", PinStyle="Output", UserPin=true },
        { Name="front_panel_lock", ControlType="Text", PinStyle="Both", UserPin=true },
        { Name="firmware_version", ControlType="Indicator", IndicatorType="Text", PinStyle="Output", Count=1, UserPin=true }
    }

    -- Input signal LEDs (individual, avoids load errors)
    for i=1,INPUTS do
        table.insert(ctls,{
            Name="input_signal_"..i,
            ControlType="Indicator",
            IndicatorType="Led",
            PinStyle="Output",
            Count=1,
            UserPin=true
        })
    end

    -- Outputs + crosspoints
    for o=1,OUTPUTS do
        table.insert(ctls,{ Name="output_"..o, ControlType="Text", PinStyle="Both", UserPin=true })
        for i=1,INPUTS do
            table.insert(ctls,{
                Name="input_"..i.."-output_"..o,
                ControlType="Button",
                ButtonType="Toggle",
                PinStyle="Both",
                UserPin=true
            })
        end
    end

    return ctls
end

-- ============================================================================
-- Layout (minimal clean layout)
-- ============================================================================
function GetPages(props)
    return { {name="Matrix"} }
end

function GetControlLayout(props)
    local layout = {}
    local graphics = {}

    local title = {224,32}
    local btn = {32,24}

    graphics[#graphics+1] = {
        Type="Header", Text="Extron DTP CrossPoint 84",
        HTextAlign="Center", Color=Colors.extron_blue,
        FontSize=16, Position={0,0}, Size=title
    }

    -- System layout
    layout["online"] = { Style="Indicator", Color={0,255,0},
        Position={100,40}, Size={24,24} }

    layout["ip_address"] = { Style="Text",
        Position={130,40}, Size={200,24} }

    layout["model"] = { Style="Text",
        Position={130,70}, Size={200,24} }

    layout["device_name"] = { Style="Text",
        Position={130,100}, Size={200,24} }

    layout["front_panel_lock"] = { Style="ComboBox",
        Position={130,130}, Size={200,24} }

    -- Matrix grid
    for o=1,OUTPUTS do
        layout["output_"..o] = {
            Style="Indicator",
            Position={40+(o*40),170},
            Size=btn
        }

        for i=1,INPUTS do
            layout["input_"..i.."-output_"..o] = {
                Style="Button",
                Legend=tostring(i),
                Position={40+(o*40),170+(i*26)},
                Size=btn
            }
        end
    end

    return layout, graphics
end

-- ============================================================================
-- Runtime
-- ============================================================================
if Controls then

    local Extron = { Host="", Port=23 }
    local password = ""

    local conn = TcpSocket.New()
    conn.ReadTimeout = 0
    conn.WriteTimeout = 0
    conn.ReconnectTimeout = 5

    local timerPoll = Timer.New()

    local function dbg(msg)
        if PluginInfo.ShowDebug then print(msg) end
    end

    -- Always CR-terminate SIS
    local function fnSend(cmd)
        if cmd:sub(-1) ~= "\r" then cmd = cmd.."\r" end
        dbg("--> "..cmd:gsub("\r","\\r"))
        conn:Write(cmd)
    end

    local function tieSuffix()
        local mode = Properties["Tie Mode"].Value
        if mode=="Video Only" then return "%" end
        if mode=="Audio Only" then return "$" end
        return "!"
    end

    local function matrix_feedback(inp,outp)
        Controls["output_"..outp].String = tostring(inp)
        for i=1,INPUTS do
            Controls["input_"..i.."-output_"..outp].Boolean = false
        end
        inp = tonumber(inp) or 0
        if inp>0 and inp<=INPUTS then
            Controls["input_"..inp.."-output_"..outp].Boolean = true
        end
    end

    local function tie(inp,outp)
        fnSend(tostring(inp).."*"..tostring(outp)..tieSuffix())
    end

    local function poll()
        for o=1,OUTPUTS do
            fnSend(tostring(o).."!")
        end
    end

    local function init()
        if Properties["Verbose"].Value then
            fnSend(string.char(27).."3CV")
        end
        fnSend("I")
        fnSend(string.char(27).."CN")
        poll()
    end

    local function connect()
        conn:Connect(Extron.Host,Extron.Port)
        Controls.ip_address.String = Extron.Host..":"..Extron.Port
    end

    -- Feedback parser (robust)
    local function parse(line)
        local outp = string.match(line,"Out(%d+)")
        local inp  = string.match(line,"In(%d+)")
        if outp and inp then
            matrix_feedback(tonumber(inp),tonumber(outp))
        end
    end

    -- Socket callbacks
    conn.Connected = function()
        Controls.online.Boolean = true
        dbg("Connected")
        Timer.CallAfter(init,1)

        timerPoll:Stop()
        local sec = tonumber(Properties["Poll Seconds"].Value) or 0
        if sec>0 then
            timerPoll.EventHandler = poll
            timerPoll:Start(sec)
        end
    end

    conn.Closed = function()
        Controls.online.Boolean = false
        dbg("Closed")
        timerPoll:Stop()
    end

    conn.Error = function(_,err)
        Controls.online.Boolean = false
        dbg("Error: "..tostring(err))
        timerPoll:Stop()
    end

    conn.Timeout = function(_,err)
        Controls.online.Boolean = false
        dbg("Timeout: "..tostring(err))
        timerPoll:Stop()
    end

    conn.Data = function()
        local line = conn:ReadLine(TcpSocket.EOL.Any)
        while line do
            dbg("<-- "..line)

            if line=="Password:" then
                conn:Write(password.."\r")
            elseif line:sub(1,5)=="Inf01" then
                Controls.model.String = line:sub(7)
            elseif line:sub(1,5)=="Ver01" then
                Controls.firmware_version.String = line:sub(7)
            elseif line:sub(1,3)=="Ipn" then
                Controls.device_name.String = line:sub(5)
            elseif line:sub(1,3)=="Exe" then
                local n=(tonumber(line:sub(4,4)) or 0)+1
                if Controls.front_panel_lock.Choices and Controls.front_panel_lock.Choices[n] then
                    Controls.front_panel_lock.String = Controls.front_panel_lock.Choices[n]
                end
            elseif string.find(line,"Out%d+") and string.find(line,"In%d+") then
                parse(line)
            end

            line = conn:ReadLine(TcpSocket.EOL.Any)
        end
    end

    -- Setup properties
    if Properties then
        Extron.Host = Properties["IP Address"].Value
        Extron.Port = tonumber(Properties["Port"].Value) or 23
        password = Properties["Password"].Value or ""
    end

    Controls.front_panel_lock.Choices = {"Unlocked","Locked","Partial"}
    Controls.front_panel_lock.EventHandler = function()
        for k,v in ipairs(Controls.front_panel_lock.Choices) do
            if Controls.front_panel_lock.String==v then
                fnSend((k-1).."X")
            end
        end
    end

    for o=1,OUTPUTS do
        Controls["output_"..o].EventHandler = function()
            tie(Controls["output_"..o].String,o)
        end
        for i=1,INPUTS do
            Controls["input_"..i.."-output_"..o].EventHandler = function()
                if Controls["input_"..i.."-output_"..o].Boolean then
                    tie(i,o)
                else
                    tie(0,o)
                end
            end
        end
    end

    if Extron.Host~="" then connect() end
end
